# CrediBridge — Environment Variables
# Copy this file to .env and fill in values.

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
# For local: postgresql://user:password@localhost:5432/credibridge
# For Neon:  postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/credibridge?sslmode=require
# For Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credibridge"

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-secret-in-production"

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ──────────────────────────────────────────────
# Optional: Gemini AI (for natural-language insights)
# ──────────────────────────────────────────────
# GEMINI_API_KEY=""
